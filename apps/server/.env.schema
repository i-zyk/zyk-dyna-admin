# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Fill in .env. Generate one with: openssl rand -base64 32
# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public URL of this server (local default; override in .env for other environments)
# @public @type=url
BETTER_AUTH_URL=http://localhost:3000

# Web app origin allowed by CORS (local default; override in .env for other environments)
# @public @type=url
CORS_ORIGIN=http://localhost:3001

# Fill in .env, e.g. postgresql://USER:PASSWORD@localhost:5432/DB_NAME
# @type=string(minLength=1)
DATABASE_URL=

# IAM is used by Aurora Express; local development keeps password authentication.
# @public @type=enum(password, iam)
DATABASE_AUTH_MODE=password

# @public @type=string
DATABASE_AWS_REGION=us-east-2

# Optional GitHub token to raise the GitHub API rate limit; leave unset to call anonymously
# @optional
GITHUB_TOKEN=
