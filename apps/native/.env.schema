NODE_ENV=development

# API server URL. localhost works in the iOS simulator; on a physical device or
# Android emulator, override in .env with your machine's LAN IP (Android emulator: http://10.0.2.2:3000)
# @public @type=url
EXPO_PUBLIC_SERVER_URL=http://localhost:3000
