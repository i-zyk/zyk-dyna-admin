{
  "name": "zyk-dyna-admin",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "auth:generate": "cd apps/server && pnpm run auth:generate",
    "build": "turbo run build",
    "build:lambda": "pnpm run db:generate && pnpm --dir apps/server run build:lambda",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @zyk-dyna-admin/db --",
    "db:migrate": "turbo run db:migrate -F @zyk-dyna-admin/db --",
    "db:push": "turbo run db:push -F @zyk-dyna-admin/db --",
    "db:studio": "turbo run db:studio -F @zyk-dyna-admin/db --",
    "dev": "turbo run dev",
    "dev:native": "turbo run dev -F native --",
    "dev:server": "turbo run dev -F server --",
    "dev:web": "turbo run dev -F web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "fix": "ultracite fix",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "catalog:",
    "@zyk-dyna-admin/config": "workspace:*",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "ultracite": "8.0.0",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@12.18.0"
}
